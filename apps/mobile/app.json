{
  "expo": {
    "name": "The Workout Tracker",
    "slug": "the-workout-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "workouttracker",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.olehalv.theworkouttracker",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.olehalv.theworkouttracker",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-web-browser",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerEnvironment": "Development",
          "iCloudContainerIdentifier": "iCloud.dev.olehalv.theworkouttracker"
        }
      ],
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "acbc3441-709f-465f-8b3b-a627662c1739"
      }
    },
    "owner": "olehalv"
  }
}
