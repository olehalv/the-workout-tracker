# Base URL of the web app (Next.js), which hosts the user/auth API.
# - iOS simulator: http://localhost:3000 works.
# - Physical device: use your computer's LAN IP, e.g. http://192.168.1.20:3000
# EXPO_PUBLIC_* vars are inlined into the app bundle at build time.
EXPO_PUBLIC_USER_API_URL=http://localhost:3000
